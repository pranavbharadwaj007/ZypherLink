<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive data from cloud backup -->
        <exclude domain="sharedpref" path="zyperlink_prefs.xml"/>
        <exclude domain="database" path="auth_tokens.db"/>
    </cloud-backup>
    <device-transfer>
        <!-- Include only app data for device transfer -->
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="zyperlink_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>